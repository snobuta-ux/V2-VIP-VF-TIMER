[Unit]
Description=VIP Vertical Farm timer (light, pump, fan)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__PROJECT_DIR__
# supervisor.py runs src.main, restarts it for website commands and undoes
# website edits that make it crash
ExecStart=__PROJECT_DIR__/venv/bin/python supervisor.py
# stop: supervisor tells the timer to turn the relays OFF first
KillMode=mixed
TimeoutStopSec=30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
